# ====== ОБЯЗАТЕЛЬНО ======
# Токен бота от @BotFather
BOT_TOKEN=

# ====== РОБОКАССА ======
# Пока пусто — бот работает в режиме витрины: всё показывает, но оплату не принимает.
# Идентификатор магазина (MerchantLogin) — в личном кабинете, раздел магазина
ROBOKASSA_LOGIN=
# Пароли из «Технических настроек» магазина.
# Пока ROBOKASSA_TEST=true — вписывайте ТЕСТОВЫЕ пароли #1 и #2, после активации — боевые.
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
# true — тестовые платежи (деньги не списываются), false — настоящие
ROBOKASSA_TEST=true
# Алгоритм хеша — как в технических настройках магазина (обычно md5)
ROBOKASSA_HASH=md5
# Передавать в Робокассу состав чека. Включайте, только если поддержка Робокассы попросит
ROBOKASSA_SEND_RECEIPT=false

# ====== ТОВАР ======
PRICE_RUB=890
PRODUCT_TITLE=Гайд «ИИ без тёмного леса»
# Описание платежа на странице Робокассы (до 100 символов, без спецсимволов)
PAYMENT_DESCRIPTION=Гайд ИИ без тёмного леса, PDF
PRODUCT_FILE=data/guide.pdf
PRODUCT_FILENAME=ИИ без тёмного леса — гайд 2026.pdf
# Персональный водяной знак с ником и ID покупателя на каждой странице
WATERMARK=true

# ====== КОНТАКТЫ И ДОКУМЕНТЫ ======
# Ваш Telegram ID (узнать: @userinfobot). Несколько — через запятую
ADMIN_IDS=
# Ник для поддержки без @
SUPPORT_USERNAME=
# Реквизиты продавца — подставляются в оферту (https://ваш-адрес/offer) и в раздел «Поддержка»
SELLER_NAME=
SELLER_INN=
SELLER_EMAIL=
# Ссылка на оферту. Оставьте пустой — бот покажет свою страницу https://ваш-адрес/offer
OFFER_URL=

# ====== АДРЕСА ДЛЯ РОБОКАССЫ ======
# Внешний адрес сервера с https:// — на VPS его заполняет скрипт установки
PUBLIC_URL=
WEB_ENABLED=true
WEB_HOST=127.0.0.1
WEB_PORT=8080

# ====== СВЯЗЬ С TELEGRAM ======
# Только если сервер/компьютер не может напрямую подключиться к Telegram.
# Пример: socks5://логин:пароль@1.2.3.4:1080  или  http://127.0.0.1:10809
TELEGRAM_PROXY=

# ====== ТЕХНИЧЕСКОЕ ======
POLL_INTERVAL_SEC=30
PAYMENT_TTL_MIN=60
DB_PATH=data/bot.db
