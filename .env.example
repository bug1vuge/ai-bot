# ====== ОБЯЗАТЕЛЬНО ======
# Токен бота от @BotFather
BOT_TOKEN=

# ====== PRODAMUS (ОПЛАТА) ======
# Пока пусто — бот работает в режиме витрины: всё показывает, но оплату не принимает.
# Адрес платёжной страницы из личного кабинета Prodamus
PRODAMUS_URL=
# Секретный ключ платёжной страницы (кабинет Prodamus → настройки → уведомления/интеграции)
PRODAMUS_SECRET=
# true — ссылку на оплату получают только ADMIN_IDS (на время проверки), false — все покупатели
PAYMENTS_TEST_MODE=false

# ====== ТОВАР ======
PRICE_RUB=990
PRODUCT_TITLE=Гайд «ИИ без тёмного леса»
# Название товара на платёжной странице и в чеке
PAYMENT_DESCRIPTION=Гайд ИИ без тёмного леса, PDF
PRODUCT_FILE=data/guide.pdf
PRODUCT_FILENAME=ИИ без тёмного леса — гайд 2026.pdf
# Персональный водяной знак с ником и ID покупателя на каждой странице
WATERMARK=true

# ====== КОНТАКТЫ И ДОКУМЕНТЫ ======
# Ваш Telegram ID (узнать: @userinfobot). Несколько — через запятую
ADMIN_IDS=
# Ник для поддержки без @
SUPPORT_USERNAME=
# Реквизиты продавца — подставляются в оферту, описание бота и раздел «Поддержка».
# ФИО — точно как в паспорте и в «Мой налог» (в паспорте РК отчества нет — без отчества)
SELLER_NAME=Малютин Максим
SELLER_INN=701760448883
SELLER_EMAIL=
# Ссылка на оферту. Оставьте пустой — бот покажет свою страницу https://ваш-адрес/offer
OFFER_URL=

# ====== АДРЕС БОТА ======
# Внешний адрес сервера с https:// — на VPS его заполняет скрипт установки.
# Уведомления Prodamus приходят на PUBLIC_URL/pay/notify
PUBLIC_URL=
WEB_ENABLED=true
WEB_HOST=127.0.0.1
WEB_PORT=8080

# ====== СВЯЗЬ С TELEGRAM ======
# Только если сервер/компьютер не может напрямую подключиться к Telegram.
# Пример: socks5://логин:пароль@1.2.3.4:1080  или  http://127.0.0.1:10809
TELEGRAM_PROXY=

# ====== ТЕХНИЧЕСКОЕ ======
POLL_INTERVAL_SEC=15
PAYMENT_TTL_MIN=60
DB_PATH=data/bot.db

# ====== ЖУРНАЛ ======
# DEBUG, INFO, WARNING или ERROR
LOG_LEVEL=INFO
